# Red Rabbit Orders Microservice - Environment Configuration
# Copy this file to .env and configure your local development environment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment: development, production, test
NODE_ENV=development

# Server port
PORT=3000

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================

# PostgreSQL connection (Constitution compliant - single URL)
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/redrabbit_orders

# Connection pool settings
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# =============================================================================
# AUTHENTICATION CONFIGURATION (Required)
# =============================================================================

# JWT verification (Constitution compliant - asymmetric preferred)
# Option 1: JWKS URL (recommended for production)
JWT_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Option 2: Public key directly (for development/testing)
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBI...\n-----END PUBLIC KEY-----

# JWT token expiration (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=24h

# JWT issuer
JWT_ISSUER=redrabbit-orders

# API key salt for hashing (MINIMUM 16 characters)
API_KEY_SALT=your-api-key-salt-16-chars-min

# Bcrypt rounds for password hashing (10-15)
BCRYPT_ROUNDS=12

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Payment Processor (Stripe, Square, etc.)
# PAYMENT_PROCESSOR_URL=https://api.stripe.com
# PAYMENT_PROCESSOR_API_KEY=pk_test_...

# Webhook configuration (Constitution compliant)
WEBHOOK_SIGNATURE_SECRET=your-webhook-signature-secret-minimum-32-characters-long
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=3

# Email/SMTP Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@domain.com
# SMTP_PASSWORD=your-app-password
# FROM_EMAIL=orders@redrabbit.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/disable major features
ENABLE_WEBHOOKS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_INVENTORY_RESERVATIONS=true
ENABLE_RATE_LIMITING=true

# =============================================================================
# MONITORING & HEALTH
# =============================================================================

# Health check interval
HEALTH_CHECK_INTERVAL_MS=30000

# Enable metrics collection
METRICS_ENABLED=true

# Log HTTP requests
REQUEST_LOGGING=true

# =============================================================================
# DEVELOPMENT/TESTING OPTIONS
# =============================================================================

# Seed database with sample data (development only)
SEED_DATA=false

# Debug SQL queries (development only)
DEBUG_SQL=false

# Mock external payment processor (development/testing)
MOCK_PAYMENT_PROCESSOR=true

# =============================================================================
# PRODUCTION NOTES
# =============================================================================

# For production deployment:
# 1. Set NODE_ENV=production
# 2. Use strong JWT_SECRET (64+ characters)
# 3. Enable DB_SSL=true
# 4. Configure real payment processor credentials
# 5. Set up proper SMTP for email notifications
# 6. Use environment-specific database credentials
# 7. Configure proper CORS_ORIGINS for your frontend
# 8. Disable debug flags (DEBUG_SQL=false, LOG_LEVEL=warn)
# 9. Consider enabling monitoring and metrics collection

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-security
JWT_EXPIRES_IN=24h

# API Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info

# External Services (Optional)
# PAYMENT_PROCESSOR_URL=https://api.stripe.com/v1
# PAYMENT_PROCESSOR_API_KEY=sk_test_...
# INVENTORY_SERVICE_URL=https://api.inventory.example.com
# INVENTORY_SERVICE_API_KEY=inv_api_key_...

# Webhook Configuration (Optional)
# WEBHOOK_SECRET=webhook-secret-key-16-chars
WEBHOOK_TIMEOUT_MS=5000

# Monitoring
MONITORING_ENABLED=false
HEALTH_CHECK_TIMEOUT_MS=5000